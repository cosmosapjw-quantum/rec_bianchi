+fn json_record(id: &str, result: Result<Observables, CoverageError>) -> Result<String, String> {
+    let (status, o) = match result {
+        Ok(o) => ("ok", o),
+        Err(e) => (err_name(&e), Observables::default()),
+    };
+    let mut values = Vec::new();
+    for (k, xs) in o.values {
+        if xs.iter().any(|x| !x.is_finite()) {
+            return Err("nonfinite observable cannot be JSON encoded".into());
+        }
+        values.push(format!(
+            "\"{k}\":[{}]",
+            xs.iter()
